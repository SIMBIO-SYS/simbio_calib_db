    <Context_Area>
        <Primary_Result_Summary>
            <purpose>Calibration</purpose>
            <processing_level>Derived</processing_level>
            <description>265x256 matrix identifying the position of a pixel classified as "bad". A
                pixel (m,n) = 1 is "bad". Stored in the same orientation as the archived raw images
                (sample order reversed with respect to the detector readout), so it applies to raw
                images pixel by pixel as delivered.</description>
